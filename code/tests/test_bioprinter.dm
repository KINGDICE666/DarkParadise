/datum/unit_test/room_test/bioprinter/Run()
	var/obj/machinery/bioprinter/printer = allocate(/obj/machinery/bioprinter)
	printer.stat = NONE
	printer.biomass = 100
	var/list/available_species = list(SPECIES_HUMAN) | CONFIG_GET(str_list/playable_species)
	TEST_ASSERT(SPECIES_HUMAN in printer.organ_catalog, "Human organs are missing from the catalog.")
	for(var/species_name in printer.organ_catalog)
		TEST_ASSERT(species_name in available_species, "[species_name] is not available in normal character creation.")
	TEST_ASSERT_EQUAL(printer.organ_catalog[SPECIES_HUMAN][INTERNAL_ORGAN_HEART]["cost"], 30, "Heart price depends on the immediate-death vital flag.")
	TEST_ASSERT_EQUAL(printer.organ_catalog[SPECIES_HUMAN][INTERNAL_ORGAN_KIDNEYS]["cost"], 20, "Ordinary organ price changed.")
	TEST_ASSERT_NOT(printer.start_printing(INTERNAL_ORGAN_BRAIN), "Bioprinter accepted a brain recipe.")
	TEST_ASSERT_NOT(printer.start_printing("invalid_slot"), "Bioprinter accepted an arbitrary recipe.")
	TEST_ASSERT_EQUAL(printer.biomass, 100, "Rejected recipes consumed biomass.")
	TEST_ASSERT(printer.start_printing(INTERNAL_ORGAN_KIDNEYS), "Bioprinter rejected a valid organ.")
	var/remaining_biomass = printer.biomass
	TEST_ASSERT_NOT(printer.start_printing(INTERNAL_ORGAN_HEART), "Bioprinter accepted a second print while busy.")
	TEST_ASSERT_EQUAL(printer.biomass, remaining_biomass, "Busy printer consumed more biomass.")
	var/remaining_time = printer.print_remaining
	printer.stat = NOPOWER
	printer.process(60)
	TEST_ASSERT_EQUAL(printer.print_remaining, remaining_time, "Unpowered printer advanced its job.")
	printer.stat = NONE
	printer.process(60)
	TEST_ASSERT_NULL(printer.printing_slot, "Powered printer did not finish its job.")
	var/obj/item/organ/internal/kidneys/printed = locate() in get_turf(printer)
	TEST_ASSERT_NOTNULL(printed, "Bioprinter did not eject the requested organ.")
	var/obj/item/organ/internal/kidneys/original = allocate(/obj/item/organ/internal/kidneys)
	TEST_ASSERT_EQUAL(printed.max_damage, original.max_damage * 0.5, "Printed organ has incorrect durability.")
	printed.AddComponent(/datum/component/bioprinted_organ)
	TEST_ASSERT_EQUAL(printed.max_damage, original.max_damage * 0.5, "Repeated component attachment reduced durability twice.")
	TEST_ASSERT_EQUAL(printed.min_broken_damage, original.min_broken_damage * 0.5, "Printed organ has incorrect failure threshold.")
	TEST_ASSERT(HAS_TRAIT(printed, TRAIT_BIOPRINTED_ORGAN), "Printed organ has no cargo rejection marker.")
	TEST_ASSERT(HAS_TRAIT(printed, TRAIT_NO_CLONE_IN_EXPERIMENTATOR), "Experimentor could clone a printed organ without its restrictions.")
	var/datum/cargo_quest/thing/organs/quest = new(null, read_datum = TRUE)
	quest.current_list = list(original.type)
	TEST_ASSERT_NOT(quest.check_required_item(printed), "Cargo accepted a bioprinted organ.")
	TEST_ASSERT_EQUAL(length(quest.current_list), 1, "Rejected organ advanced cargo progress.")
	TEST_ASSERT(quest.check_required_item(original), "Cargo rejected an original organ.")
	qdel(quest)
	var/mob/living/carbon/human/patient = allocate(/mob/living/carbon/human)
	var/obj/item/organ/internal/old_kidneys = patient.get_organ_slot(INTERNAL_ORGAN_KIDNEYS)
	qdel(old_kidneys)
	TEST_ASSERT(printed.insert(patient), "Printed organ could not be transplanted.")
	var/datum/component/bioprinted_organ/component = printed.GetComponent(/datum/component/bioprinted_organ)
	patient.nutrition = NUTRITION_LEVEL_STARVING - 1
	component.process(10)
	TEST_ASSERT(printed.damage > 0, "Starvation did not damage the transplant.")
	TEST_ASSERT_EQUAL(component.maturation_remaining, 3 MINUTES, "Starving transplant continued to mature.")
	patient.nutrition = NUTRITION_LEVEL_FULL
	ADD_TRAIT(patient, TRAIT_STASIS, type)
	component.process(10)
	TEST_ASSERT_EQUAL(component.maturation_remaining, 3 MINUTES, "Transplant matured in stasis.")
	REMOVE_TRAIT(patient, TRAIT_STASIS, type)
	component.process(180)
	TEST_ASSERT_EQUAL(component.maturation_remaining, 0, "Fed transplant did not mature.")
	TEST_ASSERT(patient.nutrition < NUTRITION_LEVEL_FULL, "Maturation did not consume nutrition.")
	TEST_ASSERT_EQUAL(printed.max_damage, original.max_damage * 0.5, "Maturation removed the durability penalty.")
	printed.remove(patient)
	printed.insert(patient)
	TEST_ASSERT_EQUAL(component.maturation_remaining, 3 MINUTES, "Retransplantation did not restart maturation.")
	qdel(printed)
	for(var/species_name in printer.organ_catalog)
		var/datum/species/species = GLOB.all_species[species_name]
		var/list/recipes = printer.organ_catalog[species_name]
		TEST_ASSERT_NOT(INTERNAL_ORGAN_BRAIN in recipes, "[species_name] has a printable brain.")
		for(var/slot in recipes)
			TEST_ASSERT(ispath(species.has_organ[slot], /obj/item/organ/internal), "[species_name] has an invalid organ recipe.")
	var/list/heart_recipe = printer.organ_catalog[SPECIES_HUMAN][INTERNAL_ORGAN_HEART]
	var/obj/item/organ/internal/heart/human_heart = allocate(/obj/item/organ/internal/heart)
	TEST_ASSERT_EQUAL(heart_recipe["icon"], human_heart.icon, "Human heart preview uses the wrong icon file.")
	TEST_ASSERT_EQUAL(heart_recipe["icon_state"], human_heart.icon_state, "Human heart preview uses the wrong icon state.")
	printer.selected_species = SPECIES_VOX
	printer.biomass = 100
	TEST_ASSERT(printer.start_printing(INTERNAL_ORGAN_LUNGS), "Vox lungs are not printable.")
	printer.process(60)
	var/obj/item/organ/internal/lungs/vox/vox_lungs = locate() in get_turf(printer)
	TEST_ASSERT_NOTNULL(vox_lungs, "Printer lost the species-specific organ subtype.")
	TEST_ASSERT_EQUAL(vox_lungs.dna.species.type, /datum/species/vox, "Printed organ has incorrect species DNA.")
	var/list/vox_lung_recipe = printer.organ_catalog[SPECIES_VOX][INTERNAL_ORGAN_LUNGS]
	TEST_ASSERT_EQUAL(vox_lung_recipe["icon"], vox_lungs.icon, "Vox lung preview uses the wrong icon file.")
	TEST_ASSERT_EQUAL(vox_lung_recipe["icon_state"], vox_lungs.icon_state, "Vox lung preview uses the wrong icon state.")
	qdel(vox_lungs)
	printer.biomass = 0
	var/obj/item/reagent_containers/food/snacks/meat/meat = allocate(/obj/item/reagent_containers/food/snacks/meat)
	patient.put_in_hands(meat)
	printer.item_interaction(patient, meat, list())
	TEST_ASSERT_EQUAL(printer.biomass, 10, "Meat was not converted to biomass.")
	TEST_ASSERT(QDELETED(meat), "Printer did not consume the loaded meat.")
	var/obj/item/reagent_containers/food/snacks/meat/partial_meat = allocate(/obj/item/reagent_containers/food/snacks/meat)
	partial_meat.reagents.remove_reagent("protein", 1.5)
	patient.put_in_hands(partial_meat)
	printer.item_interaction(patient, partial_meat, list())
	TEST_ASSERT_EQUAL(printer.biomass, 15, "Partial meat generated a full piece worth of biomass.")
	printer.biomass = printer.capacity
	var/obj/item/reagent_containers/food/snacks/meat/extra_meat = allocate(/obj/item/reagent_containers/food/snacks/meat)
	patient.put_in_hands(extra_meat)
	printer.item_interaction(patient, extra_meat, list())
	TEST_ASSERT_NOT(QDELETED(extra_meat), "Full printer consumed excess meat.")
	printer.biomass = 0
	TEST_ASSERT_NOT(printer.start_printing(INTERNAL_ORGAN_LUNGS), "Empty printer accepted a print job.")

/datum/unit_test/room_test/bioprinter_decay/Run()
	var/obj/machinery/bioprinter/printer = allocate(/obj/machinery/bioprinter)
	printer.stat = NONE
	printer.biomass = printer.capacity
	TEST_ASSERT(printer.start_printing(INTERNAL_ORGAN_KIDNEYS), "Printer rejected the decay test organ.")
	printer.process(60)
	var/obj/item/organ/internal/kidneys/printed = locate() in get_turf(printer)
	TEST_ASSERT_NOTNULL(printed, "Printer did not produce the decay test organ.")
	TEST_ASSERT(printed in SSobj.processing, "Printed organ was not registered for decay processing.")
	printed.process()
	TEST_ASSERT(printed.germ_level > 0, "Printed organ did not accumulate germs outside storage.")
	var/obj/structure/closet/crate/freezer/freezer = allocate(/obj/structure/closet/crate/freezer)
	printed.forceMove(freezer)
	printed.germ_level = INFECTION_LEVEL_THREE
	printed.process()
	TEST_ASSERT_NOT(printed.is_dead(), "Printed organ rotted in refrigerated storage.")
	printed.forceMove(get_turf(printer))
	qdel(freezer)
	printed.process()
	TEST_ASSERT(printed.is_dead(), "Printed organ did not rot after leaving storage.")
	qdel(printed)

/datum/unit_test/room_test/bioprinter_diona/Run()
	var/obj/machinery/bioprinter/printer = allocate(/obj/machinery/bioprinter)
	printer.stat = NONE
	printer.selected_species = SPECIES_DIONA
	printer.biomass = printer.capacity
	TEST_ASSERT(printer.start_printing(INTERNAL_ORGAN_APPENDIX), "Printer rejected a diona organ.")
	printer.process(60)
	var/obj/item/organ/internal/appendix/diona/printed = locate() in get_turf(printer)
	TEST_ASSERT_NOTNULL(printed, "Printer did not produce a diona organ.")
	var/mob/living/carbon/human/diona/patient = allocate(/mob/living/carbon/human/diona)
	var/obj/item/organ/internal/old_appendix = patient.get_organ_slot(INTERNAL_ORGAN_APPENDIX)
	qdel(old_appendix)
	printed.insert(patient)
	printed.remove(patient)
	TEST_ASSERT_NOT(QDELETED(printed), "Printed diona organ transformed into a nymph.")
	TEST_ASSERT(HAS_TRAIT(printed, TRAIT_BIOPRINTED_ORGAN), "Removed diona organ lost its restrictions.")
	TEST_ASSERT_NULL(locate(/mob/living/simple_animal/diona) in get_turf(patient), "Printed organ created a nymph.")
	printed.forceMove(get_turf(patient))
	TEST_ASSERT(printed in SSobj.processing, "Removed diona copy stopped decaying.")
	qdel(printed)
	var/obj/item/organ/internal/appendix/diona/original = allocate(/obj/item/organ/internal/appendix/diona)
	original.insert(patient)
	original.remove(patient)
	TEST_ASSERT(QDELETED(original), "Original diona organ no longer transforms.")
	var/mob/living/simple_animal/diona/nymph = locate() in get_turf(patient)
	TEST_ASSERT_NOTNULL(nymph, "Original diona organ did not produce a nymph.")
	qdel(nymph)

/datum/unit_test/room_test/bioprinter_maintenance/Run()
	var/obj/machinery/bioprinter/printer = allocate(/obj/machinery/bioprinter)
	var/mob/living/carbon/human/technician = allocate(/mob/living/carbon/human)
	var/obj/item/screwdriver/screwdriver = allocate(/obj/item/screwdriver)
	var/obj/item/weldingtool/welder = allocate(/obj/item/weldingtool)
	welder.toolspeed = 0
	welder.tool_enabled = TRUE
	printer.stat = NONE
	printer.biomass = printer.capacity
	TEST_ASSERT(printer.start_printing(INTERNAL_ORGAN_KIDNEYS), "Printer rejected a maintenance test job.")
	var/remaining_biomass = printer.biomass
	var/remaining_time = printer.print_remaining
	printer.update_integrity(printer.max_integrity * 0.5)
	printer.stat |= BROKEN
	TEST_ASSERT(printer.screwdriver_act(technician, screwdriver), "Broken busy printer rejected a screwdriver.")
	TEST_ASSERT(printer.panel_open, "Broken busy printer did not open its panel.")
	TEST_ASSERT_EQUAL(printer.use_power, IDLE_POWER_USE, "Printer kept drawing active power during maintenance.")
	printer.process(60)
	TEST_ASSERT_EQUAL(printer.print_remaining, remaining_time, "Printer advanced its job during maintenance.")
	printer.welder_act(technician, welder)
	TEST_ASSERT_NOT(printer.stat & BROKEN, "Welder did not repair a broken printer.")
	TEST_ASSERT_EQUAL(printer.obj_integrity, printer.max_integrity, "Welder did not restore printer integrity.")
	printer.screwdriver_act(technician, screwdriver)
	TEST_ASSERT_NOT(printer.panel_open, "Printer panel did not close after repair.")
	TEST_ASSERT_EQUAL(printer.use_power, ACTIVE_POWER_USE, "Printer did not resume active power use.")
	printer.process(60)
	TEST_ASSERT_NULL(printer.printing_slot, "Printer did not resume its interrupted job.")
	TEST_ASSERT_EQUAL(printer.biomass, remaining_biomass, "Resuming a job charged biomass twice.")
	TEST_ASSERT(printer.start_printing(INTERNAL_ORGAN_HEART), "Repaired printer rejected a new job.")
	printer.stat |= BROKEN
	printer.screwdriver_act(technician, screwdriver)
	var/obj/item/crowbar/crowbar = allocate(/obj/item/crowbar)
	printer.crowbar_act(technician, crowbar)
	TEST_ASSERT(QDELETED(printer), "Interrupted printer could not be dismantled after opening its panel.")
