/mob/living/simple_animal/slime/Hear(atom/movable/speaker, datum/language/message_language, raw_message, radio_freq, radio_freq_name, radio_freq_color, list/spans, list/message_mods = list(), message_range = 0)
	if(speaker != src && !stat && !radio_freq)
		if(speaker in Friends)
			speech_buffer = list()
			speech_buffer.Add(speaker)
			speech_buffer.Add(lowertext(html_decode(raw_message)))
	return ..()
