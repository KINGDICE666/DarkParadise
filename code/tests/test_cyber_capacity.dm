/datum/unit_test/room_test/cyber_capacity
	var/mob/living/carbon/human/patient

/datum/unit_test/room_test/cyber_capacity/Run()
	patient = allocate(/mob/living/carbon/human)
	check_overload()
	check_chips()
	check_psychosis()
	check_sensors()
	check_settings()

/datum/unit_test/room_test/cyber_capacity/proc/check_overload()
	TEST_ASSERT_EQUAL(patient.cyber_capacity, CYBER_CAPACITY_BASE, "wrong starting cyber capacity")
	TEST_ASSERT_EQUAL(get_cyberpsychosis_chance(0), 0, "psychosis chance without overload")
	TEST_ASSERT(get_cyberpsychosis_chance(100) > get_cyberpsychosis_chance(10), "psychosis chance does not grow with overload")
	for(var/path in list(/obj/item/organ/internal/cyberimp/arm/combat, /obj/item/organ/internal/cyberimp/eyes/xray, /obj/item/organ/internal/cyberimp/brain/anti_stun))
		var/obj/item/organ/internal/cyberimp/implant = allocate(path)
		TEST_ASSERT(implant.can_insert(null, patient, FALSE), "[path] was blocked by cyber capacity")
		implant.insert(patient, ORGAN_MANIPULATION_NOEFFECT)
	TEST_ASSERT_EQUAL(patient.get_cyber_load(), 95, "cyber load does not sum installed implants")
	TEST_ASSERT(patient.is_cyber_overloaded(), "overload is not detected")

/datum/unit_test/room_test/cyber_capacity/proc/check_chips()
	var/obj/item/cyber_capacity_chip/chip = allocate(/obj/item/cyber_capacity_chip)
	chip.attack_self(patient)
	TEST_ASSERT_EQUAL(patient.cyber_capacity, CYBER_CAPACITY_BASE, "chip worked without a neuroadapter")

	var/obj/item/organ/internal/cyberimp/brain/neuroadapter/adapter = allocate(/obj/item/organ/internal/cyberimp/brain/neuroadapter)
	adapter.insert(patient, ORGAN_MANIPULATION_NOEFFECT)
	chip.attack_self(patient)
	TEST_ASSERT_EQUAL(patient.cyber_capacity, CYBER_CAPACITY_BASE + CYBER_CAPACITY_CHIP_BONUS, "chip did not raise cyber capacity")
	TEST_ASSERT(QDELETED(chip), "chip was not consumed")
	TEST_ASSERT(!patient.is_cyber_overloaded(), "raised capacity did not cover the load")

	for(var/i in 1 to 10)
		var/obj/item/cyber_capacity_chip/extra_chip = allocate(/obj/item/cyber_capacity_chip)
		extra_chip.attack_self(patient)
	TEST_ASSERT_EQUAL(patient.cyber_capacity, CYBER_CAPACITY_MAX, "cyber capacity went over the maximum")
	patient.adjust_cyber_capacity(-INFINITY)
	TEST_ASSERT_EQUAL(patient.cyber_capacity, 0, "cyber capacity went below zero")
	patient.cyber_capacity = CYBER_CAPACITY_BASE + 10

/datum/unit_test/room_test/cyber_capacity/proc/check_psychosis()
	TEST_ASSERT(patient.is_cyber_overloaded(), "test setup is not overloaded")

	var/datum/status_effect/cyberpsychosis/psychosis = patient.apply_status_effect(/datum/status_effect/cyberpsychosis)
	TEST_ASSERT_NOTNULL(psychosis, "cyberpsychosis was not applied")
	for(var/i in 1 to CYBERPSYCHOSIS_STAGE_PSYCHO)
		psychosis.advance_stage()
	TEST_ASSERT(HAS_TRAIT(patient, TRAIT_CYBERPSYCHO), "final stage did not make a cyberpsycho")
	TEST_ASSERT(HAS_TRAIT(patient, TRAIT_NO_PAIN), "cyberpsycho still feels pain")
	TEST_ASSERT_EQUAL(patient.cyber_capacity, CYBER_CAPACITY_BASE, "chips did not burn out")

	psychosis.tick(2)
	TEST_ASSERT(HAS_TRAIT(patient, TRAIT_CYBERPSYCHO), "cyberpsycho was cured while overloaded")

	for(var/obj/item/organ/internal/cyberimp/implant in patient.internal_organs.Copy())
		if(implant.cyber_cost >= 30)
			implant.remove(patient)
	TEST_ASSERT(!patient.is_cyber_overloaded(), "test setup is still overloaded")
	psychosis.tick(2)
	TEST_ASSERT(QDELETED(psychosis), "cyberpsychosis was not cured after removing implants")
	TEST_ASSERT(!HAS_TRAIT(patient, TRAIT_CYBERPSYCHO), "cyberpsycho trait was left after the cure")
	TEST_ASSERT(!HAS_TRAIT(patient, TRAIT_NO_PAIN), "pain immunity was left after the cure")

/datum/unit_test/room_test/cyber_capacity/proc/check_sensors()
	var/obj/item/organ/internal/cyberimp/brain/neuroadapter/adapter = patient.get_organ_slot(INTERNAL_ORGAN_BRAIN_NEUROADAPTER)
	TEST_ASSERT(adapter.set_ripper_setting("sensors", "Полный мониторинг"), "sensor setting was rejected")
	TEST_ASSERT(hassensorlevel(patient, SUIT_SENSOR_TRACKING), "neuroadapter sensors are not read")
	adapter.remove(patient)
	TEST_ASSERT_EQUAL(getsensorlevel(patient), SUIT_SENSOR_OFF, "sensors still report without a neuroadapter")

/datum/unit_test/room_test/cyber_capacity/proc/check_settings()
	var/obj/item/organ/internal/cyberimp/arm/toolset/toolset = allocate(/obj/item/organ/internal/cyberimp/arm/toolset)
	toolset.insert(patient, ORGAN_MANIPULATION_NOEFFECT)
	TEST_ASSERT(toolset.set_ripper_setting("side", "Левая"), "arm implant did not move to a free arm")
	TEST_ASSERT_EQUAL(patient.get_organ_slot(INTERNAL_ORGAN_L_ARM_DEVICE), toolset, "arm implant is not in the left arm slot")
	TEST_ASSERT_EQUAL(toolset.owner, patient, "arm implant was not reinserted")

	var/obj/item/organ/internal/cyberimp/eyes/thermals/thermals = allocate(/obj/item/organ/internal/cyberimp/eyes/thermals)
	thermals.insert(patient, ORGAN_MANIPULATION_NOEFFECT)
	thermals.set_ripper_setting("vision", FALSE)
	TEST_ASSERT(!(thermals.vision_flags & SEE_MOBS), "disabled thermals still give thermal vision")
	thermals.set_ripper_setting("vision", TRUE)
	TEST_ASSERT(thermals.vision_flags & SEE_MOBS, "enabled thermals do not give thermal vision")

	var/obj/item/organ/internal/cyberimp/brain/anti_stun/anti_stun = patient.get_organ_slot(INTERNAL_ORGAN_BRAIN_ANTISTUN)
	anti_stun = anti_stun || allocate(/obj/item/organ/internal/cyberimp/brain/anti_stun)
	TEST_ASSERT(anti_stun.set_ripper_setting("active", FALSE), "pause setting was rejected")
	TEST_ASSERT(anti_stun.paused, "implant was not paused")
