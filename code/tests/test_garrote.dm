/datum/unit_test/room_test/garrote_release/Run()
	for(var/garrote_type in list(/obj/item/twohanded/garrote, /obj/item/twohanded/garrote/improvised))
		for(var/release_method in list("stop_pulling", "unwield", "delete_garrote", "delete_victim", "change_target"))
			var/mob/living/carbon/human/strangler = allocate(/mob/living/carbon/human, run_loc_floor_bottom_left)
			var/mob/living/carbon/human/victim = allocate(/mob/living/carbon/human, run_loc_floor_bottom_left)
			var/obj/item/twohanded/garrote/garrote = allocate(garrote_type)
			var/obj/item/left_item = allocate(/obj/item/pen)
			var/obj/item/right_item = allocate(/obj/item/pen)
			var/trait_source = UNIQUE_TRAIT_SOURCE(garrote)
			strangler.setDir(SOUTH)
			victim.setDir(SOUTH)
			strangler.put_in_active_hand(garrote)
			garrote.attack_self(strangler)
			TEST_ASSERT(HAS_TRAIT(garrote, TRAIT_WIELDED), "[garrote_type]: failed to wield garrote")
			victim.put_in_l_hand(left_item)
			victim.put_in_r_hand(right_item)
			stoplag()
			world.invoke_callback_with_usr(strangler, CALLBACK(garrote, TYPE_PROC_REF(/obj/item/twohanded/garrote, attack), victim, strangler))
			TEST_ASSERT_EQUAL(garrote.strangling, victim, "[garrote_type]: failed to start strangling")
			TEST_ASSERT(HAS_TRAIT_FROM(victim, TRAIT_HANDS_BLOCKED, trait_source), "[garrote_type]: victim's hands were not blocked")
			TEST_ASSERT_NOT(victim.can_unarmed_attack(), "[garrote_type]: victim could attack while strangled")
			TEST_ASSERT_EQUAL(left_item.loc, get_turf(victim), "[garrote_type]: left-hand item was not dropped")
			TEST_ASSERT_EQUAL(right_item.loc, get_turf(victim), "[garrote_type]: right-hand item was not dropped")
			ADD_TRAIT(victim, TRAIT_HANDS_BLOCKED, UNIQUE_TRAIT_SOURCE(src))
			switch(release_method)
				if("stop_pulling")
					strangler.stop_pulling()
				if("unwield")
					garrote.unwield(garrote, strangler)
				if("delete_garrote")
					qdel(garrote)
				if("delete_victim")
					qdel(victim)
				if("change_target")
					var/mob/living/carbon/human/other_victim = allocate(/mob/living/carbon/human, run_loc_floor_bottom_left)
					TEST_ASSERT(strangler.start_pulling(other_victim), "[garrote_type]: failed to change pull target")
			TEST_ASSERT_NULL(garrote.strangling, "[garrote_type], [release_method]: strangling reference was not cleared immediately")
			if(QDELETED(victim))
				continue
			TEST_ASSERT_NOT(HAS_TRAIT_FROM(victim, TRAIT_HANDS_BLOCKED, trait_source), "[garrote_type], [release_method]: hands remained blocked until processing")
			TEST_ASSERT(HAS_TRAIT_FROM(victim, TRAIT_HANDS_BLOCKED, UNIQUE_TRAIT_SOURCE(src)), "[garrote_type], [release_method]: removed another source's hand restriction")
			REMOVE_TRAIT(victim, TRAIT_HANDS_BLOCKED, UNIQUE_TRAIT_SOURCE(src))
			strangler.stop_pulling()
			TEST_ASSERT(victim.can_unarmed_attack(), "[garrote_type], [release_method]: victim could not attack after release")
