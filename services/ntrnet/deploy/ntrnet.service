[Unit]
Description=NTrnet API
After=network.target mariadb.service

[Service]
User=ntrnet
Group=ntrnet
WorkingDirectory=/srv/ntrnet
EnvironmentFile=/etc/ntrnet.env
ExecStart=/srv/ntrnet/.venv/bin/python app.py
Restart=on-failure
RestartSec=5
MemoryMax=256M
CPUQuota=50%
Nice=19
OOMScoreAdjust=500
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/ntrnet-media
UMask=0077

[Install]
WantedBy=multi-user.target
