/datum/unit_test/overmap_celestial_gravity/Run()
	TEST_ASSERT_EQUAL(overmap_gravity_accel(6, 1, 1, 6), 0, "Gravity must end at the edge of the well.")
	TEST_ASSERT_EQUAL(overmap_gravity_accel(2, 1, 1, 6), 0.25, "Gravity must fall off with the square of distance.")
	TEST_ASSERT_EQUAL(overmap_gravity_accel(0, 1, 1, 6), 1, "Gravity inside the core must be capped at the core radius.")
	TEST_ASSERT_EQUAL(overmap_gravity_accel(0, 1, 0.1, 6), 4, "A tiny core must still be capped by the core floor.")
	TEST_ASSERT_EQUAL(overmap_celestial_zone(0.5, 1, 2.5, 6), OVERMAP_CELESTIAL_ZONE_CORE, "Unexpected celestial zone.")
	TEST_ASSERT_EQUAL(overmap_celestial_zone(2, 1, 2.5, 6), OVERMAP_CELESTIAL_ZONE_HAZARD, "Unexpected celestial zone.")
	TEST_ASSERT_EQUAL(overmap_celestial_zone(5, 1, 2.5, 6), OVERMAP_CELESTIAL_ZONE_GRAVITY, "Unexpected celestial zone.")
	TEST_ASSERT_EQUAL(overmap_celestial_zone(7, 1, 2.5, 6), OVERMAP_CELESTIAL_ZONE_CLEAR, "Unexpected celestial zone.")

/datum/unit_test/overmap_celestial_placement/Run()
	var/datum/overmap_sector/sector = SSovermap.wilderness_sector
	TEST_ASSERT_NOTNULL(sector, "The wilderness sector must exist.")
	var/obj/overmap/celestial/body = place_overmap_celestial(sector, /obj/overmap/celestial/black_hole)
	TEST_ASSERT_NOTNULL(body, "A black hole must fit into the wilderness sector.")
	TEST_ASSERT(body in GLOB.overmap_celestials, "A placed body must be registered.")
	TEST_ASSERT(sector.turf_occupied(locate(body.x + 1, body.y, body.z)), "The hazard zone of a body must be closed for other spawns.")
	for(var/obj/overmap/entity/hyperrelay/relay in sector.objects)
		TEST_ASSERT(sqrt((relay.x - body.x) ** 2 + (relay.y - body.y) ** 2) >= body.hazard_radius + OVERMAP_CELESTIAL_RELAY_CLEARANCE, "A body must not be placed next to a hyperrelay.")
	var/list/box = body.navigation_box(body.span())
	TEST_ASSERT(box[1] < body.x * body.span() && box[3] > body.x * body.span(), "The navigation box must surround the body.")
	sector.remove_object(body)
	qdel(body)
	TEST_ASSERT_NOT(body in GLOB.overmap_celestials, "A deleted body must be unregistered.")

/datum/unit_test/overmap_nebula/Run()
	var/obj/overmap/feature/hazard/nebula/ion/cloud = allocate(/obj/overmap/feature/hazard/nebula/ion)
	TEST_ASSERT_EQUAL(hazard_flavour(cloud), OVERMAP_NEBULA_ION, "A nebula must report its own flavour.")
	cloud.generate_scatter()
	TEST_ASSERT_EQUAL(length(cloud.scatter_points), 0, "A nebula must not create solid scatter.")
	TEST_ASSERT(cloud.cloud_strength(cloud.x * OVERMAP_TILE_SPAN, cloud.y * OVERMAP_TILE_SPAN) > 0, "A nebula must be dense at its own cell.")
	TEST_ASSERT_EQUAL(cloud.cloud_strength((cloud.x + 3) * OVERMAP_TILE_SPAN, cloud.y * OVERMAP_TILE_SPAN), 0, "A lone nebula cell must not reach three cells away.")
