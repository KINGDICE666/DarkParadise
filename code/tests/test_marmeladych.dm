/datum/unit_test/room_test/marmeladych/Run()
	var/obj/item/storage/box/marmeladych/pack = allocate(/obj/item/storage/box/marmeladych)
	var/mob/living/carbon/human/eater = allocate(/mob/living/carbon/human)
	TEST_ASSERT_EQUAL(length(pack.contents), 7, "The pack must start with seven gummies.")
	var/icon/pack_icon = icon(pack.icon, pack.icon_state)
	TEST_ASSERT_EQUAL(pack_icon.Width(), 64, "The pack must use the 64px sprite.")
	eater.put_in_hands(pack)
	pack.attack_self(eater)
	TEST_ASSERT_EQUAL(length(pack.contents), 6, "Activating the pack must dispense one gummy.")
	var/obj/item/reagent_containers/food/snacks/candy/gummybear/marmeladych/gummy = locate() in eater
	TEST_ASSERT(gummy, "The dispensed gummy must be in the eater's hands.")
	gummy.reagents.clear_reagents()
	gummy.On_Consume(eater, eater)
	var/effect_count = 0
	for(var/datum/status_effect/marmeladych/effect in eater.status_effects)
		effect_count++
	TEST_ASSERT_EQUAL(effect_count, 1, "Finishing a gummy must apply exactly one of its three effects.")
	eater.remove_status_effect(STATUS_EFFECT_MARMELADYCH_WIDE)
	eater.remove_status_effect(STATUS_EFFECT_MARMELADYCH_TOILET)
	eater.remove_status_effect(STATUS_EFFECT_MARMELADYCH_INFLATION)

	var/matrix/original_transform = matrix(eater.transform)
	eater.apply_status_effect(STATUS_EFFECT_MARMELADYCH_WIDE)
	TEST_ASSERT(HAS_TRAIT(eater, TRAIT_FAT), "The wide effect must make the eater fat.")
	TEST_ASSERT_EQUAL(eater.transform.a, original_transform.a * 6, "The eater must become six times wider.")
	eater.apply_status_effect(STATUS_EFFECT_MARMELADYCH_WIDE)
	TEST_ASSERT_EQUAL(eater.transform.a, original_transform.a * 6, "Eating another wide gummy must not multiply the width again.")
	eater.set_lying_angle(LYING_ANGLE_EAST)
	sleep(UPDATE_TRANSFORM_ANIMATION_TIME)
	eater.remove_status_effect(STATUS_EFFECT_MARMELADYCH_WIDE)
	eater.set_lying_angle(0)
	sleep(UPDATE_TRANSFORM_ANIMATION_TIME)
	TEST_ASSERT(abs(eater.transform.a - original_transform.a) < 0.01, "The width must recover even after the eater falls over.")
	TEST_ASSERT(abs(eater.transform.e - original_transform.e) < 0.01, "Removing the width effect must preserve the eater's height.")
	TEST_ASSERT(!HAS_TRAIT(eater, TRAIT_FAT), "The wide effect must clean up its fat trait.")

	var/datum/status_effect/marmeladych/toilet/toilet_effect = eater.apply_status_effect(STATUS_EFFECT_MARMELADYCH_TOILET)
	TEST_ASSERT(toilet_effect?.toilet, "The toilet effect must create a vehicle.")
	var/obj/vehicle/ridden/marmeladych_toilet/toilet = toilet_effect.toilet
	TEST_ASSERT_EQUAL(eater.buckled, toilet, "The eater must immediately mount the toilet.")
	TEST_ASSERT(toilet.is_driver(eater), "The eater must be able to control the toilet.")
	var/turf/destination = get_step(toilet, NORTH)
	toilet.relaymove(eater, NORTH)
	TEST_ASSERT_EQUAL(get_turf(toilet), destination, "Movement input must move the toilet.")
	TEST_ASSERT_EQUAL(get_turf(eater), destination, "The rider must travel with the toilet.")
	toilet.unbuckle_mob(eater, force = TRUE)
	TEST_ASSERT(!eater.buckled, "The rider must be able to dismount.")
	eater.apply_status_effect(STATUS_EFFECT_MARMELADYCH_TOILET)
	TEST_ASSERT(QDELETED(toilet), "Another toilet gummy must clean up the previous toilet.")
	toilet = toilet_effect.toilet
	TEST_ASSERT_EQUAL(eater.buckled, toilet, "Another toilet gummy must seat the eater again.")
	eater.remove_status_effect(STATUS_EFFECT_MARMELADYCH_TOILET)
	TEST_ASSERT(QDELETED(toilet), "Ending the effect must clean up the toilet.")
	TEST_ASSERT(!eater.buckled, "Ending the effect must release the rider.")

	var/obj/machinery/vending/snack/vendor = allocate(/obj/machinery/vending/snack)
	var/mob/living/carbon/human/customer = allocate(/mob/living/carbon/human)
	var/datum/tgui/eater_ui = new(eater, vendor, "Vending")
	var/datum/tgui/customer_ui = new(customer, vendor, "Vending")
	var/list/normal_payload = eater_ui.get_payload(null, TRUE, TRUE)
	eater.apply_status_effect(STATUS_EFFECT_MARMELADYCH_INFLATION)
	var/list/affected_payload = eater_ui.get_payload(null, TRUE, TRUE)
	var/list/customer_payload = customer_ui.get_payload(null, TRUE, TRUE)
	TEST_ASSERT_EQUAL(affected_payload["config"]["credit_price_override"], 999, "The affected customer must see inflated credit prices.")
	TEST_ASSERT_NULL(customer_payload["config"]["credit_price_override"], "Other customers must see normal prices.")
	TEST_ASSERT_EQUAL(json_encode(normal_payload["static_data"]["product_records"]), json_encode(affected_payload["static_data"]["product_records"]), "Price hallucinations must not change the vendor's prices or affordability data.")
	eater.remove_status_effect(STATUS_EFFECT_MARMELADYCH_INFLATION)
	var/list/recovered_payload = eater_ui.get_payload(null, TRUE, FALSE)
	TEST_ASSERT_NULL(recovered_payload["config"]["credit_price_override"], "Prices must recover on a regular UI update after the effect ends.")
	qdel(eater_ui)
	qdel(customer_ui)
